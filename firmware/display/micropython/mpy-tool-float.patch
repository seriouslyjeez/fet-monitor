+def c_float(x):
+    """A float constant in C: 17 significant digits (a double needs them all to come back to the same bits) and
+    infinities and NaN by name (Python prints them as inf and nan, which C does not know)."""
+    if x != x:
+        return "NAN"
+    if x in (float("inf"), float("-inf")):
+        return "INFINITY" if x > 0 else "(-INFINITY)"
+    return "%.17g" % x
