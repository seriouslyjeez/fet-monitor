[Unit]
Description=FeT Monitor server
After=network-online.target
Wants=network-online.target

[Service]
User=fet-monitor
Group=fet-monitor
WorkingDirectory=/opt/fet-monitor
ExecStart=/usr/bin/python3 -m fetserver serve --data-dir /var/lib/fet-monitor --port 8080
Restart=always
RestartSec=2
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/fet-monitor

[Install]
WantedBy=multi-user.target
