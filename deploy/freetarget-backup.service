[Unit]
Description=freETarget database backup

[Service]
Type=oneshot
User=freetarget
Group=freetarget
WorkingDirectory=/opt/freetarget-server
ExecStart=/usr/bin/python3 -m fetserver backup --data-dir /var/lib/freetarget --to /var/backups/freetarget --keep 14
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/freetarget /var/backups/freetarget
