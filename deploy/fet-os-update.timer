[Unit]
Description=FeT Monitor: nightly Raspberry Pi OS update, about 04:00 (after the 03:30 backup)

[Timer]
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=1800
# Not Persistent: a Pi switched off at night is not updated the moment it starts at the range (Range Control shows
# its age and has "Update the Pi now").

[Install]
WantedBy=timers.target
